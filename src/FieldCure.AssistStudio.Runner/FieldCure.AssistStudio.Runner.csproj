<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>FieldCure.AssistStudio.Runner</RootNamespace>
    <AssemblyName>assiststudio-runner</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <Version>2.0.1</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <PackageId>FieldCure.AssistStudio.Runner</PackageId>

    <Authors>Jong Hyun Kim</Authors>
    <Company>Fieldcure Co., Ltd.</Company>
    <Copyright>Copyright (c) 2026 Fieldcure Co., Ltd.</Copyright>
    <Description>Windows-only headless LLM task automation engine with scheduling. Executes natural language tasks on schedule via Windows Task Scheduler and sends results through configured channels.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/fieldcure/fieldcure-assiststudio-runner</PackageProjectUrl>
    <RepositoryUrl>https://github.com/fieldcure/fieldcure-assiststudio-runner</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>mcp;mcp-server;ai;dotnet;llm;automation;scheduler;runner;task-scheduler</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>Logo.png</PackageIcon>
    <PackageReleaseNotes>v2.0.1: Completes the dnx migration on the Runner side. Drops the preference for tool-path-installed binaries under the retired %LOCALAPPDATA%\FieldCure\AssistStudio\tools\ folder (which AssistStudio stopped populating in mid-April), eliminating the silent version-skew failures that occurred when stale binaries shadowed the dnx-cached current versions. WindowsTaskScheduler now spawns dnx directly for schtasks-fired exec workers. RunnerConfig.DetectInstalledServers replaces the dual global/local tool-path scan with dnx-based discovery; each stateless server (essentials, outbox) is pinned at its current major range so breaking changes never sneak in mid-cycle. RunnerConfig.Load auto-migrates pre-2.0.1 runner.json files — any defaultMcpServers[].command pointing into the legacy tools/ folder is rewritten to the equivalent dnx command and saved back. Existing schtasks entries registered under v2.0.0 still encode the old tool-path and need re-registration via update_task; runner.json migration is automatic.</PackageReleaseNotes>

    <PackageType>McpServer</PackageType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>assiststudio-runner</ToolCommandName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FieldCure.AssistStudio.Runner.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FieldCure.Ai.Providers" Version="0.*" />
    <PackageReference Include="FieldCure.Ai.Execution" Version="0.*" />
    <PackageReference Include="ModelContextProtocol" Version="1.2.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.*" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="Logo.png" Pack="true" PackagePath="" />
    <None Include=".mcp/server.json" Pack="true" PackagePath=".mcp/" />
  </ItemGroup>

</Project>
