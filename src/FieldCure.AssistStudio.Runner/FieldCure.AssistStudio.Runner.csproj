<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>FieldCure.AssistStudio.Runner</RootNamespace>
    <AssemblyName>assiststudio-runner</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <Version>2.0.4</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <PackageId>FieldCure.AssistStudio.Runner</PackageId>

    <Authors>Jong Hyun Kim</Authors>
    <Company>Fieldcure Co., Ltd.</Company>
    <Copyright>Copyright (c) 2026 Fieldcure Co., Ltd.</Copyright>
    <Description>Windows-only headless LLM task automation engine with scheduling. Executes natural language tasks on schedule via Windows Task Scheduler and sends results through configured channels.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/fieldcure/fieldcure-assiststudio-runner</PackageProjectUrl>
    <RepositoryUrl>https://github.com/fieldcure/fieldcure-assiststudio-runner</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>mcp;mcp-server;ai;dotnet;llm;automation;scheduler;runner;task-scheduler</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>Logo.png</PackageIcon>
    <PackageReleaseNotes>v2.0.4: Rebuilt against FieldCure.Ai.Providers 0.8.0 (IToolContext + ElicitationFieldInfo namespace move + StopReason enum + StructuredContent plumbing + Gemini IMAGE modality + globally-unique Gemini tool_call_ids) and FieldCure.Ai.Execution 0.4.1, picked up automatically via the floating Version="0.*" reference. The Ai.Providers 0.8.0 breaking changes (ElicitationFieldInfo namespace move + ChatMessage.IsTruncated setter removal) are transparent to Runner — it does not use either type directly. Also includes pack-time VerifyServerJsonVersion MSBuild target (catches drift between csproj &lt;Version&gt; and .mcp/server.json) and publish-mcp-registry.yml GitHub Actions workflow (manual workflow_dispatch via OIDC). No runtime behaviour changes in scheduled-task execution, output channel notification, or MCP protocol handling.</PackageReleaseNotes>

    <PackageType>McpServer</PackageType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>assiststudio-runner</ToolCommandName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FieldCure.AssistStudio.Runner.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FieldCure.Ai.Providers" Version="0.*" />
    <PackageReference Include="FieldCure.Ai.Execution" Version="0.*" />
    <PackageReference Include="ModelContextProtocol" Version="1.2.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.*" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="Logo.png" Pack="true" PackagePath="" />
    <None Include=".mcp/server.json" Pack="true" PackagePath=".mcp/" />
  </ItemGroup>

  <!-- Sync check: .mcp/server.json's "version" fields must match csproj <Version>.
       The JSON descriptor is metadata for the MCP Server Registry; if the two
       drift, the registry listing reports the wrong version even though the
       published nupkg itself is correct. Runs before pack and errors out on
       the literal token `"version": "$(Version)"` so a mismatched dev pack
       fails immediately with a descriptive message. -->
  <Target Name="VerifyServerJsonVersion" BeforeTargets="GenerateNuspec">
    <PropertyGroup>
      <_ServerJsonContent>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\.mcp\server.json'))</_ServerJsonContent>
      <_ExpectedVersionToken>"version": "$(Version)"</_ExpectedVersionToken>
    </PropertyGroup>
    <Error Condition="!$(_ServerJsonContent.Contains($(_ExpectedVersionToken)))"
           Text=".mcp/server.json version is out of sync with csproj &lt;Version&gt;$(Version)&lt;/Version&gt;. Update both 'version' fields in .mcp/server.json to match before packing." />
  </Target>

</Project>
